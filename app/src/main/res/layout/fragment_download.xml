<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="horizontal">

    <ScrollView
        android:id="@+id/sidebar_scroll"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sidebar"
            style="@style/Sidebar">

            <LinearLayout
                android:id="@+id/nav_release"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_about" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/download_nav_release" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_beta"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_global" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/download_nav_beta" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_dl_resource"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_resource" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_resource" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_dl_behavior"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_behavior" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_behavior" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_dl_world"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_world" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_worlds" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_dl_plugin"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_plugin" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_plugins" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Version list group: shown for 正式版 / 测试版. The header and search are kept to two
             compact rows so the list itself gets the vertical room — in landscape the chrome was
             eating half the pane and only a couple of builds stayed visible. -->
        <LinearLayout
            android:id="@+id/group_versions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/group_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/download_nav_release"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <!-- The site's download page is driven by a version-family dropdown (1.10.x ..
                     1.21.x); get_version returns the whole family for the chosen channel. -->
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/family_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="96dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_refresh"
                    app:icon="@drawable/ic_action_download"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- One compact row: the search field takes the width, the action buttons sit to its
                 right. 显示最新 only appears while a search result is on screen. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/search_field"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/download_search_hint"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/search_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/download_search_button"
                    app:icon="@drawable/ic_action_search"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_show_latest"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/download_show_latest"
                    android:visibility="gone"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/download_loading_versions"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <ListView
                android:id="@+id/version_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@null"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Reserved group: shown for 资源包 / 行为包 / 世界 / 插件 -->
        <TextView
            android:id="@+id/group_reserved"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/download_reserved_coming"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOutline"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
