<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="horizontal">

    <ScrollView
        android:id="@+id/sidebar_scroll"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sidebar"
            style="@style/Sidebar">

            <LinearLayout
                android:id="@+id/nav_worlds"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_world" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_worlds" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_resource"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_resource" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_resource" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_behavior"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_behavior" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_behavior" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_global"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_global" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_global" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_plugin"
                style="@style/SidebarItem">

                <ImageView style="@style/SidebarItemIcon" android:src="@drawable/ic_nav_plugin" android:contentDescription="@null" />

                <TextView style="@style/SidebarItemText" android:text="@string/content_tab_plugins" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- The managed page, with the instance picker as its header (task #33): the sidebar picks
         what kind of content to show, the header picks which installation owns it. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/instance_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/instance_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/text_no_instance"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/content_no_instance"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOutline"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
