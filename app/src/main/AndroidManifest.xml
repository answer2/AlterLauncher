    <!-- Opt out of the predictive back gesture. It becomes the default for
         targetSdk 36, and NativeActivity games are exactly the case it breaks: once
         the gesture is enabled the framework stops delivering the back KEY events
         that Minecraft reads off its own input queue, so in-game screens stop
         responding to back. Keeping the legacy path costs nothing here and leaves
         the game's own back handling untouched.
         TODO: revisit when the game side drives OnBackInvokedCallback.
         (The comment sits outside the tag on purpose - XML forbids comments between
         attributes, and the manifest merger fails the whole file on one.) -->
    <application
        android:name=".AlterApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:preserveLegacyExternalStorage="true"
        android:requestLegacyExternalStorage="true"
        android:screenOrientation="landscape"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="r"
        tools:ignore="DiscouragedApi">

