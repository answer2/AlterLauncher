        <!--
            Launcher-owned anchor for the game window. AlterInstrumentation.newActivity()
            substitutes com.mojang.minecraftpe.MainActivity for this component, so the
            game's classes are defined by the DexClassLoader built over the Minecraft APK
            (whose library search path is the game's native lib dir) instead of the
            launcher's loader. Framework theme on purpose: after the swap the activity's
            resources are the game's, so a launcher resource id would not resolve.
        -->
        <activity
            android:name=".ui.activity.GameHostActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="false"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity="com.answer.launcher.game"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi" >
            <meta-data
                android:name="android.app.lib_name"
                android:value="minecraftpe" />
        </activity>
        <!--
            The UI process' live view of the runtime. Lives in :game next to the
            state it reports (guest LoadedApk, guest loader, hook tables, plugin
            managers). GameBridgeClient.bind() parks a binding with no
            BIND_AUTO_CREATE, so reading state can never cold-boot the game
            process; only the launch paths call wake(), which upgrades that
            binding — and they are the same paths that start GameHostActivity.
        -->
        <service
            android:name="com.answer.launcher.core.bridge.GameBridgeService"
            android:exported="false"
            android:process=":game" >
            <intent-filter>
                <action android:name="com.answer.launcher.core.bridge.GameBridgeService" />
            </intent-filter>
        </service>
